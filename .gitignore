# Node
node_modules/
dist/
*.local

# Python
.venv/
__pycache__/
*.pyc

# Secrets — only the .example files are tracked
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.vscode/
.idea/

# Local reference material (hackathon rules, hosting docs) — never committed
docs_offline/

# Claude Code project config and local skills — kept out of the public repo
.claude/
CLAUDE.md

# local dev logs
.logs/

# large public-domain PDFs for OMR testing
api/fixtures/pdf/

# full-size exploration screenshots (2 MB); contact sheets in sheets/ are committed
docs/design/explorations/shots/

# voice-note recordings (ground truth CSV is committed)
api/fixtures/voice/*.m4a
api/fixtures/voice/audio/
api/fixtures/voice/*.wav
api/fixtures/voice/*.mp3

# R3 verification screenshots (local, like the explorations shots)
docs/design/r3/shots/

# never a symlink either (a worktree once committed one and the merge overwrote the real folder)
api/fixtures/pdf
api/fixtures/voice/audio/
api/experiments/voice/out/
api/experiments/spark12/runs/**/*.png

# Vite cache (a stray copy once landed under api/)
.vite/

# Spend ledgers: every experiment's own usage log stays local
api/experiments/**/spend*.jsonl
api/experiments/**/spend*.json

# Raw run records stay local; each experiment's summary (.md) is committed
api/experiments/**/results/*
!api/experiments/**/results/*.md
api/experiments/**/runs/**
!api/experiments/**/runs/**/
!api/experiments/**/runs/**/*.md
api/experiments/**/out/
api/experiments/engrave/v2/
api/experiments/engrave/goldberg/text-layer/

# Recordings of a real voice, and their recording briefs
api/fixtures/voice/audio2/
api/fixtures/voice/script2.md

# e2e harness scratch (session tokens, page crops)
api/experiments/e2e_night/scratch/
